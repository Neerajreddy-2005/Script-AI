    {
      "parameters": {
        "jsCode": "const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst para = (s) => esc(s).replace(/\\n/g, '<br>');\nconst wrap = (inner) => `<div style=\"font-family:Arial,sans-serif;max-width:640px;color:#111827\">${inner}<p style=\"color:#9ca3af;font-size:12px;margin-top:24px\">Sent by Script-AI</p></div>`;\nconst e = $json.body;\nconst d = e.data;\nconst sources = (d.sources || []).map((s) => `<li>[${esc(s.id)}] ${esc(s.filename)}</li>`).join('');\nconst html = wrap(\n  `<h2 style=\"margin-bottom:4px\">${esc(d.title)}</h2>` +\n  (d.platform ? `<p style=\"color:#6b7280;margin-top:0\">${esc(d.platform)} script</p>` : '') +\n  `<h3>Introduction</h3><p>${para(d.introduction)}</p>` +\n  `<h3>Main content</h3><p>${para(d.mainContent)}</p>` +\n  `<h3>Conclusion</h3><p>${para(d.conclusion)}</p>` +\n  (sources ? `<h4>Sources</h4><ul>${sources}</ul>` : '')\n);\nconst text = `${d.title}\\n\\nINTRODUCTION\\n${d.introduction}\\n\\nMAIN CONTENT\\n${d.mainContent}\\n\\nCONCLUSION\\n${d.conclusion}`;\nconst subject = d.background ? `Your script is ready: ${d.title}` : `Your script: ${d.title}`;\nreturn { json: { to: e.user.email, subject, html, text } };",
        "mode": "runOnceForEachItem"
      },
      "id": "57922ba8-e2ac-5674-888b-e4d013e62ff1",

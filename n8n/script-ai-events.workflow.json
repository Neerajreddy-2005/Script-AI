      "parameters": {
        "jsCode": "const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst para = (s) => esc(s).replace(/\\n/g, '<br>');\nconst wrap = (inner) => `<div style=\"font-family:Arial,sans-serif;max-width:640px;color:#111827\">${inner}<p style=\"color:#9ca3af;font-size:12px;margin-top:24px\">Sent by Script-AI</p></div>`;\nconst e = $json.body;\nconst d = e.data;\nconst html = wrap(\n  `<h2>We couldn't finish your ${esc(d.platform)} script</h2>` +\n  `<p>${esc(d.message || 'Something went wrong.')}</p>` +\n  `<p style=\"color:#6b7280\">Error code: ${esc(d.error_code)} · request ${esc(e.request_id)}</p>` +\n  `<p>Please try again from the dashboard.</p>`\n);\nconst text = `We couldn't finish your ${d.platform} script.\\n${d.message || ''}\\nError code: ${d.error_code}`;\nreturn { json: { to: e.user.email, subject: 'Script-AI: your script could not be generated', html, text } };",
        "mode": "runOnceForEachItem"
      },

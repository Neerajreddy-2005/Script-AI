# Copy to .env.local and fill in. Only public values belong here (everything VITE_* ships to the browser).

# FastAPI backend (documents, reminders, email, background jobs).
VITE_BACKEND_URL=http://localhost:8000

# Optional, local development only: route script generation through the n8n "Script-AI Generate (2.0)" workflow.
# Leave empty (as in production) to call FastAPI directly.
VITE_N8N_WEBHOOK_URL=

# Supabase -> Project Settings -> API Keys. Never put the secret/service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

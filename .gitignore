# OS / Editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env files (secrets)
.env
.env.*
frontend/.env
frontend/.env.*
backend/.env
backend/.env.*
# Templates with placeholder values only (never real keys).
!.env.example
!frontend/.env.example
!backend/.env.example

# Eval run outputs (regenerate with backend/eval/run_eval.py)
backend/eval/results/*
!backend/eval/results/.gitkeep
!backend/eval/results/baseline_report.md

# Python / Backend
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
ENV/
env/
*.pyc
*.pyo
*.pyd

# Build artifacts
backend/.coverage*
coverage/
dist/
build/

# n8n: exported credentials, local data, and personal re-exports.
# n8n/*.workflow.json ARE committed (placeholder secrets only). Re-export your
# live workflows as *.local.json / *.export.json so real secrets never get committed.
*.credentials.json
*.secrets.json
.n8n/
n8n/*.export.json
backend/Backend.json
backend/*.json

# Keys, certificates, local overrides
*.local
*.local.json
*.secret
*.pem
*.key
*.p12

# Deploy tooling state (contains site/project IDs)
.netlify/
.vercel/
supabase/.temp/
supabase/.branches/

# Local Claude Code settings
.claude/settings.local.json


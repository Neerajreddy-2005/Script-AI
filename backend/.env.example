# Copy to backend/.env and fill in every line marked  <-- REQUIRED.  Never commit backend/.env.
# On Render the same keys go in the dashboard (render.yaml already sets the non-secret ones).
# Setup: README.md (Getting started), n8n/README.md, docs/operations.md (Deploying).

# =============================== APP =================================

# development locally; production on Render (refuses to start with unsafe settings).
APP_ENV=development
# The frontend's exact origin(s), comma-separated. Production: https://<site>.netlify.app
FRONTEND_ORIGINS=http://localhost:8081

# =============================== LLM =================================
# Any OpenAI-compatible API. Key: https://openrouter.ai/keys

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=                                   # <-- REQUIRED (OpenRouter key, sk-or-...)

# ============================ EMBEDDINGS =============================
# Gemini free tier, the same in local dev and production (one model = comparable vectors).
# Key: https://aistudio.google.com/apikey
# Changing the embedding model later? Delete and re-upload your knowledge-base documents.

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_API_KEY=                             # <-- REQUIRED (Gemini key)
# Must equal vector(N) in migrations/001_init.sql. Gemini is shortened to 768 via SEND_DIMENSIONS.
EMBEDDING_DIM=768
EMBEDDING_SEND_DIMENSIONS=true

# Offline alternative (local dev only, not reachable from Render): Ollama, `ollama pull nomic-embed-text`
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_API_KEY=
# EMBEDDING_SEND_DIMENSIONS=false

# ============================= SUPABASE ==============================
# Dashboard -> Connect -> Session pooler (port 5432), with your database password filled in.
DATABASE_URL=                                  # <-- REQUIRED (postgresql://postgres.<ref>:<password>@...pooler.supabase.com:5432/postgres)
SUPABASE_URL=https://your-project-ref.supabase.co   # <-- REQUIRED (replace your-project-ref)
# Only if the CURRENT JWT signing key is "Legacy HS256"; leave empty for ECC/RSA signing keys.
SUPABASE_JWT_SECRET=
AUTH_DISABLED=false

# =============================== n8n =================================
# Emails ("Email me", background jobs) and reminders. Leave BOTH empty to run without email.
# Local: http://localhost:5678/webhook/scriptai-events
# Production (Render): your tunnel URL, e.g. https://<name>.ngrok-free.app/webhook/scriptai-events
N8N_EVENTS_URL=http://localhost:5678/webhook/scriptai-events
# Random string, 16+ characters. The same value goes into the n8n "Valid secret?" and "Config" nodes.
N8N_SHARED_SECRET=                             # <-- REQUIRED for email/reminders

# ============================== OPTIONAL ==============================
# Defaults shown. Uncomment to change.

# LOG_LEVEL=INFO
# LLM_TEMPERATURE=0.7
# LLM_TIMEOUT_SECONDS=60
# Set false if your provider rejects response_format.
# LLM_JSON_MODE=true
# USD per 1M tokens, only for cost estimates in responses and logs.
# LLM_INPUT_COST_PER_MTOK=
# LLM_OUTPUT_COST_PER_MTOK=

# MAX_UPLOAD_SIZE_MB=5
# MAX_DOCUMENTS_PER_USER=50
# RAG_TOP_K=5
# Tune with POST /api/knowledge/search (different embedding models need different values).
# RAG_MIN_SIMILARITY=0.25

# MAX_AGENT_REVISIONS=2
# Generations per user per UTC day, by app_metadata.subscription.
# QUOTA_BASIC=10
# QUOTA_PRO=50
# QUOTA_PREMIUM=200
# MAX_PENDING_REMINDERS_PER_USER=50

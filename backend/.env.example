# Copy to backend/.env and fill in. Never commit backend/.env.
# Setup: README.md (Getting started) and n8n/README.md.

# ============================== REQUIRED ==============================

APP_ENV=development
# The frontend's exact origin (scheme://host:port). Comma-separate several.
FRONTEND_ORIGINS=http://localhost:8081

# --- LLM (any OpenAI-compatible API, e.g. OpenRouter) -------------------
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# --- Embeddings (free: Ollama nomic-embed-text = 768 dims) ---------------
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
# Must equal vector(N) in migrations/001_init.sql.
EMBEDDING_DIM=768

# --- Supabase ------------------------------------------------------------
# Connect -> URI -> Session pooler.
DATABASE_URL=
SUPABASE_URL=https://your-project-ref.supabase.co
# Only for projects still on the legacy JWT secret; leave empty for the new JWT signing keys.
SUPABASE_JWT_SECRET=
AUTH_DISABLED=false

# --- n8n automations (emails, reminders) ---------------------------------
# Production URL of the "Script-AI Events & Email" workflow's webhook.
N8N_EVENTS_URL=http://localhost:5678/webhook/scriptai-events
# Long random string. The same value goes into the n8n workflows (see n8n/README.md).
N8N_SHARED_SECRET=

# ============================== OPTIONAL ==============================
# Defaults shown. Uncomment to change.

# LOG_LEVEL=INFO
# LLM_TEMPERATURE=0.7
# LLM_TIMEOUT_SECONDS=60
# Set false if your provider rejects response_format.
# LLM_JSON_MODE=true
# USD per 1M tokens, only for cost estimates in responses and logs.
# LLM_INPUT_COST_PER_MTOK=
# LLM_OUTPUT_COST_PER_MTOK=
# Ask the API to shorten vectors to EMBEDDING_DIM (models that support it).
# EMBEDDING_SEND_DIMENSIONS=false

# MAX_UPLOAD_SIZE_MB=5
# MAX_DOCUMENTS_PER_USER=50
# RAG_TOP_K=5
# Tune with POST /api/knowledge/search.
# RAG_MIN_SIMILARITY=0.25

# MAX_AGENT_REVISIONS=2
# Generations per user per UTC day, by app_metadata.subscription.
# QUOTA_BASIC=10
# QUOTA_PRO=50
# QUOTA_PREMIUM=200
# MAX_PENDING_REMINDERS_PER_USER=50
